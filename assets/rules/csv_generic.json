{
  "institution": "Generic CSV",
  "rule_version": 1,
  "engine_min": 1,
  "extractor": "csv",
  "detect": {
    "date_headers": ["Date", "Transaction Date", "Posted Date", "Value Date"],
    "amount_headers": ["Amount", "Value", "Transaction Amount"],
    "debit_headers": ["Debit", "Withdrawal", "Money Out", "Withdrawn"],
    "credit_headers": ["Credit", "Deposit", "Money In", "Paid In"]
  },
  "layout": {
    "header_row": 0
  },
  "direction": "drcr_column",
  "fields": {
    "date": ["Date", "Transaction Date", "Posted Date", "Value Date", "Completion Time"],
    "vendor": ["Description", "Details", "Particulars", "Vendor", "Payee"],
    "amount": "Amount",
    "source_ref": ["Receipt No.", "Receipt No", "FITID"],
    "debit": ["Debit", "Withdrawal", "Money Out", "Withdrawn"],
    "credit": ["Credit", "Deposit", "Money In", "Paid In"],
    "balance": "Balance"
  },
  "keep_rows": [],
  "skip_rows_containing": ["Balance Brought Forward"],
  "vendor": [
    {"match": ".*", "normalize": "Preserve"}
  ]
}
